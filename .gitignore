# В репозиторий попадает только код. Всё, что содержит данные компании,
# контрагентов и физических лиц, остаётся на рабочем компьютере.

# --- выгрузки из 1С: вся дебиторка компании ---------------------------------
*.xls
*.xlsx
*.csv
data/uploaded/
data/contracts/

# --- справочники и реестр: реквизиты, УНП, счета, ФИО, история долгов -------
data/contragents.csv
data/journal.csv

# --- готовые документы: суммы, реквизиты, ФИО должников ---------------------
output/

# --- результаты проверок -----------------------------------------------------
tests/output/

# --- служебное ---------------------------------------------------------------
__pycache__/
*.pyc
.venv/
venv/
~$*
*.tmp

# --- исключения: эти файлы нужны в репозитории, данных в них нет -------------
!data/refinancing_rate.csv
!data/tariffs.json
!examples/*.xlsx

# --- локальные настройки ассистентов -----------------------------------------
.claude/
CLAUDE.md
